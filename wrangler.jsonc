{
  "name": "engsitetools",
  "compatibility_date": "2026-10-05",
  // Serve the site only at engsitetools.com, not also at a *.workers.dev address,
  // so search engines don't find a second copy of every page.
  "workers_dev": false,
  "preview_urls": false,
  // Only the contact form API runs code. Everything else is a static file.
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Contact form messages can only ever be sent to this one address.
  "send_email": [
    { "name": "CONTACT_EMAIL", "destination_address": "support@engsitetools.com" }
  ],
  // TURNSTILE_SECRET is a Worker secret (wrangler secret put), never in this file.
  "vars": {
    "TURNSTILE_HOSTNAMES": "engsitetools.com"
  }
}
